{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "cpu",
    "memory",
    "custom/gpu",
    "custom/separator",
    "custom/caffeine",
    "custom/bluetooth",
    "network",
    "custom/power"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "persistent-workspaces": {
      "DP-1": ["1:M1", "2:M2", "3:M3", "4:M4", "5:M5"],
      "DP-2": ["6:A1", "7:A2", "8:A3", "9:A4", "10:A5"]
    },
    "format": "{name}"
  },
  "clock": {
    "interval": 10,
    "format": "{:%a, %b %d · %H:%M}"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage:>3}%"
  },
  "memory": {
    "interval": 5,
    "format": " {percentage:>3}%"
  },
  "custom/gpu": {
    "interval": 10,
    "exec": "/home/alexander-yoon/.local/bin/gpu-usage.sh",
    "return-type": "text"
  },
  "custom/separator": {
    "exec": "printf '|'",
    "interval": "once",
    "return-type": "text",
    "tooltip": false
  },
  "custom/caffeine": {
    "interval": 2,
    "exec": "/home/alexander-yoon/.local/bin/caffeine.sh status",
    "signal": 1,
    "return-type": "text",
    "on-click": "/home/alexander-yoon/.local/bin/caffeine.sh toggle"
  },
  "custom/bluetooth": {
    "interval": 5,
    "exec": "/home/alexander-yoon/.local/bin/bluetooth.sh status",
    "return-type": "json",
    "on-click": "/home/alexander-yoon/.local/bin/bluetooth.sh menu"
  },
  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "/home/alexander-yoon/.local/bin/wifimenu.sh",
    "on-click-right": "/home/alexander-yoon/.local/bin/launch-kitty.sh -e nmtui"
  },
  "custom/power": {
    "format": "",
    "on-click": "/home/alexander-yoon/.local/bin/powermenu.sh",
    "tooltip": false
  }
}
