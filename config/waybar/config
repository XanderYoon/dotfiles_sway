{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "cpu",
    "memory",
    "custom/gpu",
    "custom/theme",
    "custom/caffeine",
    "network",
    "custom/power"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },
  "clock": {
    "interval": 10,
    "format": "{:%a, %b %d · %H:%M}"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage:>3}%"
  },
  "memory": {
    "interval": 5,
    "format": " {percentage:>3}%"
  },
  "custom/gpu": {
    "interval": 10,
    "exec": "~/.local/bin/gpu-usage.sh",
    "return-type": "text"
  },
  "custom/theme": {
    "interval": 2,
    "exec": "~/.config/theme/theme-status.sh",
    "return-type": "text",
    "on-click": "~/.config/theme/toggle-theme.sh"
  },
  "custom/caffeine": {
    "interval": 2,
    "exec": "~/.local/bin/caffeine.sh status",
    "return-type": "text",
    "on-click": "~/.local/bin/caffeine.sh toggle"
  },
  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.local/bin/wifimenu.sh",
    "on-click-right": "kitty -e nmtui"
  },
  "custom/power": {
    "format": "",
    "on-click": "~/.local/bin/powermenu.sh",
    "tooltip": false
  }
}
